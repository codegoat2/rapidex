# ============================================================
# RapidEx Bot — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ---- Discord -----------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_guild_id

# Discord Role IDs (also editable live in the dashboard Settings page)
ROLE_ADMIN=discord_admin_role_id
ROLE_EXCHANGER=discord_exchanger_role_id

# Discord Channel IDs
CHANNEL_ADMIN_ALERTS=discord_admin_alerts_channel_id
CHANNEL_ANNOUNCEMENTS=discord_announcements_channel_id
TICKET_CATEGORY_ID=discord_trade_category_id

# ---- Database (Supabase) -----------------------------------
# Direct connection — Project Settings → Database → URI (port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Transaction pooler — optional, port 6543
# DATABASE_POOL_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ---- Encryption --------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ---- HD Wallet Master Seed ---------------------------------
# BIP39 24-word mnemonic — NEVER share or commit this
MASTER_WALLET_MNEMONIC=twenty four word bip39 mnemonic phrase goes here

# ---- NOWNodes (single API key for ALL chains) --------------
# Sign up at https://account.nownodes.io → Dashboard → Add New Key
NOWNODES_API_KEY=your_nownodes_api_key_here

# ---- Admin Dashboard ---------------------------------------
# Password to log in at https://velxoai.xyz/dashboard
# Generate: openssl rand -hex 24
DASHBOARD_SECRET=your_strong_dashboard_password_here

# ---- Network -----------------------------------------------
NETWORK=testnet

# ---- HTTP Server (Railway sets PORT automatically) ---------
PORT=3000
WEBHOOK_PORT=3000

# Your Railway/custom domain
WEBHOOK_BASE_URL=https://velxoai.xyz

# Webhook HMAC secret for NOWNodes deposit callbacks
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ---- Hot Wallet Addresses (for balance monitoring) ---------
HOT_WALLET_BTC=
HOT_WALLET_LTC=
HOT_WALLET_ETH=
HOT_WALLET_SOL=

# ---- Sentry (optional) -------------------------------------
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ---- Application -------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# ---- Trade Timeouts ----------------------------------------
TIMEOUT_OPEN_MINUTES=30
TIMEOUT_CLAIMED_MINUTES=60
TIMEOUT_FIAT_SENT_MINUTES=60
TIMEOUT_DISPUTED_HOURS=24
TIMEOUT_CRYPTO_SENT_CONFIRMATIONS=2

# ---- Rate Limits -------------------------------------------
RATE_LIMIT_TICKET_PER_USER_PER_HOUR=3
RATE_LIMIT_COMMANDS_PER_USER_PER_MINUTE=10

# ---- Hot Wallet Alert Thresholds ---------------------------
MIN_HOT_WALLET_BTC=0.01
MIN_HOT_WALLET_LTC=1.0
MIN_HOT_WALLET_ETH=0.1
MIN_HOT_WALLET_SOL=5.0
