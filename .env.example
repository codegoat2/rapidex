# ============================================================
# RapidEx Bot — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ---- Discord -----------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_discord_server_guild_id

# Discord Role IDs
ROLE_ADMIN=discord_admin_role_id
ROLE_EXCHANGER=discord_exchanger_role_id

# Discord Channel IDs
CHANNEL_ADMIN_ALERTS=discord_admin_alerts_channel_id
CHANNEL_ANNOUNCEMENTS=discord_announcements_channel_id

# ---- Database (Supabase) -----------------------------------
# Direct connection — Project Settings → Database → URI (port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Transaction pooler — optional, port 6543 (append ?pgbouncer=true)
# DATABASE_POOL_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ---- Encryption --------------------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ---- HD Wallet Master Seed ---------------------------------
# BIP39 24-word mnemonic — NEVER share or commit this
MASTER_WALLET_MNEMONIC=twenty four word bip39 mnemonic phrase goes here for wallet derivation

# ---- NOWNodes (single API key for ALL chains) --------------
# Sign up at https://account.nownodes.io → Dashboard → Add New Key
# Select: BTC, LTC, ETH, SOL (+ testnet variants if needed)
NOWNODES_API_KEY=your_nownodes_api_key_here

# ---- Network -----------------------------------------------
# "mainnet" or "testnet"
NETWORK=testnet

# ---- Webhook HTTP Server -----------------------------------
# PORT is set automatically by Railway. Match WEBHOOK_PORT to it.
PORT=3000
WEBHOOK_PORT=3000

# Your Railway public domain (set after first deploy)
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# Shared secret for internal webhook verification
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here

# ---- Hot Wallet Addresses (for balance monitoring) ---------
HOT_WALLET_BTC=
HOT_WALLET_LTC=
HOT_WALLET_ETH=
HOT_WALLET_SOL=

# ---- Sentry Error Monitoring (optional) --------------------
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ---- Application -------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- Trade Timeouts (minutes unless noted) -----------------
TIMEOUT_OPEN_MINUTES=30
TIMEOUT_CLAIMED_MINUTES=60
TIMEOUT_FIAT_SENT_MINUTES=60
TIMEOUT_DISPUTED_HOURS=24
TIMEOUT_CRYPTO_SENT_CONFIRMATIONS=2

# ---- Rate Limits -------------------------------------------
RATE_LIMIT_TICKET_PER_USER_PER_HOUR=3
RATE_LIMIT_COMMANDS_PER_USER_PER_MINUTE=10

# ---- Hot Wallet Alert Thresholds ---------------------------
MIN_HOT_WALLET_BTC=0.01
MIN_HOT_WALLET_LTC=1.0
MIN_HOT_WALLET_ETH=0.1
MIN_HOT_WALLET_SOL=5.0
