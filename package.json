{
  "name": "rapidex-bot",
  "version": "1.0.0",
  "description": "RapidEx — Production-grade Discord bot for crypto escrow and exchange",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:rollback": "ts-node src/db/migrate.ts --rollback",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "smoke-test": "ts-node src/db/smoke-test.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "@neondatabase/serverless": "^0.9.3",
    "@sentry/node": "^7.109.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.7",
    "@types/bip39": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.6.8",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.5",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "discord-api-types": "^0.37.83",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "ecpair": "^2.1.0",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.11.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "node-cron": "^3.0.3",
    "pm2": "^5.3.1",
    "postgres": "^3.4.4",
    "tiny-secp256k1": "^2.2.3",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
